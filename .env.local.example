# Neon: project dashboard > Connect > copy the connection string (the pooled one)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Gemini: https://aistudio.google.com/apikey (needed from Phase 4)
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.5-flash. (gemini-2.5-flash is no longer open to new keys.)
GEMINI_MODEL=

# Protects the schedule endpoint (needed from Phase 6). Any long random string.
CRON_SECRET=
