# Copy this file to .env.local and fill it in. .env.local is never committed.
# On Vercel, put the same names and values under Project > Settings > Environment Variables.

# Neon: project dashboard > Connect > turn Connection pooling ON > copy the string that starts with postgresql://
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Gemini key from https://aistudio.google.com/apikey (writes the one-line reasons; the system works without it)
GEMINI_API_KEY=

# Protects the schedule endpoints. Any long random string (at least 16 characters).
# Vercel Cron sends it automatically as a bearer token when this variable exists.
CRON_SECRET=

# Optional
# GEMINI_MODEL=gemini-3.5-flash        # the model that writes reasons
# GEMINI_RPM=8                         # requests per minute to stay under
# GEMINI_DAILY_LIMIT=20                # the free tier allows 20 requests a day; the app spends them on the most urgent flags first
# GEMINI_THINKING_LEVEL=minimal
